#!/usr/bin/env bash

set -euo pipefail

current_script_path=${BASH_SOURCE[0]}
plugin_dir=$(dirname "$(dirname "$current_script_path")")

# shellcheck source=./lib/utils.bash
. "${plugin_dir}/lib/utils.bash"

curl_opts=(-sIL)

if [ -n "${GITHUB_TOKEN:-}" ]; then
	curl_opts=("${curl_opts[@]}" -H "Authorization: token $GITHUB_TOKEN")
fi

# curl of REPO/releases/latest is expected to be a 302 to another URL
# when no releases redirect_url="REPO/releases"
# when there are releases redirect_url="REPO/releases/tag/v<VERSION>"
redirect_url=$(curl "${curl_opts[@]}" "$GH_REPO/releases/latest" | sed -n -e "s|^[Ll]ocation: *||p" | tr -d '\r' | tail -n1)
version=
printf "redirect url: %s\n" "$redirect_url" >&2
if [[ "$redirect_url" == *"/releases/tag/"* ]]; then
	version="$(printf "%s\n" "$redirect_url" | sed 's|.*/tag/v\{0,1\}||')"
else
	# No releases, or the request failed: fall back to the repository tags.
	version="$(list_stable_versions | sort_versions | tail -n1 | xargs echo)"
fi

[ -n "$version" ] || fail "Could not determine the latest stable version"

printf "%s\n" "$version"
