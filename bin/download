#!/usr/bin/env bash

set -euo pipefail

current_script_path=${BASH_SOURCE[0]}
plugin_dir=$(dirname "$(dirname "$current_script_path")")

# shellcheck source=./lib/utils.bash
source "${plugin_dir}/lib/utils.bash"

mkdir -p "$ASDF_DOWNLOAD_PATH"

release_file_base="$ASDF_DOWNLOAD_PATH/$TOOL_NAME-$ASDF_INSTALL_VERSION"

# Download release archive (sets RELEASE_EXT to tar.gz or zip)
download_release "$ASDF_INSTALL_VERSION" "$release_file_base"

release_file="$release_file_base.$RELEASE_EXT"

# Extract contents based on archive type
if [[ "$RELEASE_EXT" == "tar.gz" ]]; then
	# Architecture-specific archives are Homebrew bottles, which nest the binary
	# as <tool>/<version>/bin/<tool>. Extract aside, then flatten.
	extract_path="$ASDF_DOWNLOAD_PATH/.extract"
	mkdir -p "$extract_path"
	tar -xzf "$release_file" -C "$extract_path" || fail "Could not extract $release_file"

	tool_path=$(find "$extract_path" -type f -name "$TOOL_NAME" | head -n 1)
	[ -n "$tool_path" ] || fail "Could not find $TOOL_NAME in $release_file"

	mv "$tool_path" "$ASDF_DOWNLOAD_PATH/$TOOL_NAME"
	rm -rf "$extract_path"
else
	# Universal zip has flat structure: xcodes at root
	unzip -q "$release_file" -d "$ASDF_DOWNLOAD_PATH" || fail "Could not extract $release_file"
fi

[ -f "$ASDF_DOWNLOAD_PATH/$TOOL_NAME" ] || fail "Expected $TOOL_NAME in $release_file"
chmod +x "$ASDF_DOWNLOAD_PATH/$TOOL_NAME"

# Remove the archive since we don't need to keep it
rm "$release_file"
